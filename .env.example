# Redis URL for local runs. Docker Compose overrides this to use the `redis` service.
REDIS_URL=redis://localhost:6379

# Base URL for the optional HTTP adapter (OpenAI-compatible).
LLM_BASE_URL=http://localhost:11434

# Optional bearer token for the HTTP adapter.
LLM_API_KEY=

# HTTP timeout for LLM calls (seconds)
LLM_TIMEOUT=30

# result cache TTL (seconds)
CACHE_TTL=300

# max requests per minute per API key (sliding window)
RATE_LIMIT_RPM=60

# comma-separated API keys
API_KEYS=test-key-1,test-key-2

# Stub-only failure rate. 0.0 = always succeed, 1.0 = always timeout.
STUB_FAILURE_RATE=0.0

# `stub` is zero-config for local/dev. `http` sends real OpenAI-compatible requests.
LLM_ADAPTER=stub
