# Redis URL
REDIS_URL=redis://redis:6379

# upstream LLM base URL (OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434

# HTTP timeout for LLM calls (seconds)
LLM_TIMEOUT=30

# result cache TTL (seconds)
CACHE_TTL=300

# max requests per minute per API key (sliding window)
RATE_LIMIT_RPM=60

# comma-separated API keys
API_KEYS=test-key-1,test-key-2

# fraction of stub calls that raise TimeoutError — 0.0 = never, 1.0 = always
STUB_FAILURE_RATE=0.0

# 'stub' works without external deps; 'http' targets a real provider
LLM_ADAPTER=stub
